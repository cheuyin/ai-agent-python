Output assets/demo.gif

Set Shell "zsh"
Set FontSize 13
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms
Set PlaybackSpeed 1.5

Env PATH "/Users/cheuyin/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

Type "uv run main.py"
Enter
Sleep 6s

Type "write a python script called fibonacci.py that prints the first 20 fibonacci numbers, then run it"
Enter
Sleep 50s
